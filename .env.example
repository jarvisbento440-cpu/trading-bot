# Kopiere diese Datei nach .env und trage deine Werte ein.
# .env wird NIE ins Repository hochgeladen.

# Telegram: Bot bei @BotFather anlegen, Token hier eintragen
TELEGRAM_BOT_TOKEN=
# Deine Chat-ID (z. B. über @userinfobot herausfinden)
TELEGRAM_CHAT_ID=

# Optional, erst später nötig (Börsen-Keys braucht der Bot NICHT)
COINGECKO_API_KEY=
CRYPTOPANIC_API_KEY=
ETHERSCAN_API_KEY=
